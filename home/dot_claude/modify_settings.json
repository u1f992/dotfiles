{{- /* chezmoi:modify-template */ -}}
{{- $settings := `
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/reject-words.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/reject-words.ts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)",
      "Bash(git push:*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "language": "japanese",
  "autoMemoryEnabled": false
}
` | fromJson -}}
{{- $existing := dict -}}
{{- if .chezmoi.stdin }}{{ $existing = fromJson .chezmoi.stdin }}{{ end -}}
{{ mergeOverwrite $existing $settings | toPrettyJson -}}
