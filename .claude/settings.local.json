{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/reject-words.local.ts",
            "args": []
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/reject-words.local.ts",
            "args": []
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)",
      "Bash(git push:*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0"
  },
  "language": "japanese",
  "autoMemoryEnabled": false
}
