{
  "description": "Personal writing-policy hooks migrated from Claude Code.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/reject-words.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/reject-words.ts"
          }
        ]
      }
    ]
  }
}
